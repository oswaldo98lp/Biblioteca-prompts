rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Verifica que el usuario haya iniciado sesión con Google con el correo oswaldo1998.lp@gmail.com
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'oswaldo1998.lp@gmail.com';
    }

    // Configuración global del sitio y metadatos de elementos eliminados
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lectura pública de todas las colecciones del portal; escritura exclusiva para el administrador
    match /{collectionName}/{docId} {
      allow read: if collectionName in ['prompts', 'links', 'files', 'blocks', 'partsCards', 'faqs'];
      allow create, update, delete: if isAdmin();
    }
  }
}
