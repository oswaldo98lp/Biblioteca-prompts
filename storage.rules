rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'oswaldo98lp@gmail.com';
    }

    // Archivos descargables del taller (.pdf, .xlsx, .csv) con límite de 10 MB
    match /workshop-resources/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size <= 10 * 1024 * 1024
                   && fileName.matches('.*\\.(pdf|xlsx|csv|PDF|XLSX|CSV)$');
    }
  }
}
